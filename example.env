# Database (Docker Postgres on host port 5437)
DATABASE_URL=postgresql://sarafi_suite:sarafi_suite@localhost:5437/sarafi_suite

# App
APP_NAME=Sarafi Digital Suite
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=dev-secret-change-in-production

# Auth cookies
ACCESS_COOKIE_NAME=sarafi_suite_access
REFRESH_COOKIE_NAME=sarafi_suite_refresh
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# CORS / frontend (Docker frontend is http://localhost:3004)
BACKEND_CORS_ORIGINS=http://localhost:3004,http://localhost:5173
FRONTEND_URL=http://localhost:3004

# Seed admin
SEED_ADMIN_EMAIL=admin@sarafi.local
SEED_ADMIN_PASSWORD=Admin123!@#

# Uploaded article images (relative to backend working directory)
UPLOAD_DIR=uploads

# Frontend: browser uses same-origin /api (Vite proxy). Leave VITE_API_URL empty.
VITE_API_URL=
# SSR + Vite proxy target (Docker Compose uses http://backend:8000)
API_URL=http://localhost:8003

# --- Railway backend ---
# On the FastAPI service in the SAME Railway project as Postgres, set:
# DATABASE_URL=${{Postgres.DATABASE_URL}}   (use Railway "Reference Variable", not a public URL)
# The postgres.railway.internal URL only works inside Railway, which is correct for backend→DB.
#
# After deploying backend, Railway gives a public URL like:
# https://sarafi-backend-production.up.railway.app
# Use that as API_URL on Vercel (no trailing slash).
#
# Backend env (Railway → backend service → Variables):
# SECRET_KEY=<openssl rand -hex 32>
# ENVIRONMENT=production
# DEBUG=false
# FRONTEND_URL=https://your-app.vercel.app
# BACKEND_CORS_ORIGINS=https://your-app.vercel.app
# COOKIE_SECURE=true
# COOKIE_SAMESITE=lax
# SEED_ADMIN_EMAIL=admin@sarafi.local
# SEED_ADMIN_PASSWORD=<strong password>
# UPLOAD_DIR=uploads
#
# --- Vercel (frontend only) ---
# API_URL=https://your-backend.up.railway.app
# VITE_API_URL=same-origin
